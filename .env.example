# Optional overrides for docker-compose.yml. Copy to .env and edit; every value
# already has the default shown here, so a clean clone runs without a .env file.
# These are local development credentials for a disposable, seeded database.

# Host ports (services bind to 127.0.0.1 only)
ERP_DB_HOST_PORT=5433
PARTNER_API_HOST_PORT=8000

# ERP database
ERP_DB_NAME=arkham
ERP_DB_ADMIN_USER=arkham
ERP_DB_ADMIN_PASSWORD=arkham

# Read-only role used by the pipeline to extract from the ERP
ERP_DB_READER_USER=arkham_reader
ERP_DB_READER_PASSWORD=arkham_reader

# Pipeline Spark sizing, within the 2 GB container limit
SPARK_DRIVER_MEMORY=1g
SPARK_MASTER=local[2]

# Optional Prefect layer (v4): host port of the Prefect UI
PREFECT_HOST_PORT=4200
